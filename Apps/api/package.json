{
  "name": "@dragon-telecom/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --require dotenv/config src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract",
    "test:int": "NODE_ENV=test vitest run --config vitest.integration.config.ts test/integration",
    "lint": "eslint src test prisma --no-color",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@dragon-telecom/contract": "file:../contract",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "bwip-js": "^4.11.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.0.0"
  }
}
