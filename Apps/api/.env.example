# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dragon_telecom_dev
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/dragon_telecom_test

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth
# Must be at least 32 characters
JWT_SECRET=change_this_to_a_long_random_secret_32chars_minimum
JWT_EXPIRATION=15m
# Days (not a duration string) — see env-template.md
REFRESH_TOKEN_EXPIRATION=7

# Logging
LOG_LEVEL=info

# Cloudflare R2 (image storage) — S26.1
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="dragon-telecom"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_PUBLIC_URL="https://media.example.com"
