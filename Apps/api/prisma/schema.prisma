// Dragon Telecom — schema.prisma (Final)
// Source of truth for persisted data. Enum values are identical to the contract's enums.
// Conventions: uuid PKs, createdAt/updatedAt everywhere, Decimal(12,2) money (DZD, cash only),
// isEnabled instead of delete, snapshots on immutable documents, serials as free text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserType {
  ADMIN
  STAFF
  CLIENT
}

enum PageScope {
  ADMIN
  STAFF
}

enum ClientStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MovementDirection {
  IN
  OUT
  PENDING
}

enum MovementType {
  SUPPLIER_INVOICE
  INITIAL_STOCK
  ADJUSTMENT_IN
  RETURN_IN
  SALE
  ORDER_OUT
  REPAIR_CONSUMPTION
  ADJUSTMENT_OUT
  PENDING_ORDER
  PENDING_REPAIR
  PENDING_RELEASE
}

enum AdjustmentReason {
  COUNT
  DAMAGE
  LOSS
  CORRECTION
}

enum SupplierInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  RETURNED
  PARTIALLY_RETURNED
  CANCELLED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKAGED
  IN_DELIVERY
  COMPLETED
  CANCELLED
  // D4 — client-initiated cancellation; terminal, releases the reservation exactly like CANCELLED.
  CANCELLED_BY_CLIENT
  RETURNED
}

enum OrderType {
  PICKUP
  DELIVERY_HOME
  DELIVERY_OFFICE
}

enum RepairStatus {
  INTAKE
  PROCESSING
  COMPLETED
  PICKED_UP
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceSource {
  SALE
  ORDER
  REPAIR
}

enum ClientActivityType {
  SEARCH
  PRODUCT_VIEW
  CATALOG_SESSION
}

// ────────────────────── Identity & Access ──────────────────────

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  type         UserType
  isEnabled    Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  staff         Staff?
  client        Client?
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  searchLogs    StaffSearchLog[]
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  approvedClients  Client[]          @relation("ClientApprovedBy")
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  sales            Sale[]
  returns          Return[]
  confirmedOrders  Order[]           @relation("OrderConfirmedBy")
  repairHistory    RepairStatusHistory[]
  invoices         Invoice[]
  clientPayments   ClientPayment[]
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePages RolePage[]
  userRoles UserRole[]
}

model Page {
  id        String    @id @default(uuid())
  key       String    @unique
  label     String
  group     String
  scope     PageScope
  rolePages RolePage[]
}

model RolePage {
  roleId String
  pageId String

  role Role @relation(fields: [roleId], references: [id])
  page Page @relation(fields: [pageId], references: [id])

  @@id([roleId, pageId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Technician {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairs Repair[]
}

// ────────────────────── Geography & Delivery ──────────────────────

model Wilaya {
  id         String @id @default(uuid())
  wilayaCode String @unique
  frName     String
  arName     String

  communes     Commune[]
  deliveryFees DeliveryFee[]
  clients      Client[]
  orders       Order[]
}

model Commune {
  id          String @id @default(uuid())
  communeCode String @unique
  wilayaId    String
  frName      String
  arName      String

  wilaya       Wilaya        @relation(fields: [wilayaId], references: [id])
  deliveryFees DeliveryFee[]
  clients      Client[]
  orders       Order[]

  @@index([wilayaId])
}

model DeliveryFee {
  id             String  @id @default(uuid())
  wilayaId       String
  communeId      String? // null = the wilaya-level fee; non-null = explicit commune override
  deliveryHome   Decimal @db.Decimal(12, 2)
  deliveryOffice Decimal @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  wilaya  Wilaya   @relation(fields: [wilayaId], references: [id])
  commune Commune? @relation(fields: [communeId], references: [id])

  @@unique([wilayaId, communeId])
}

// ─────────────────────────── Clients ───────────────────────────

model ClientCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posClients    PosClient[]
  productPrices ProductPrice[]
}

model Client {
  id                String       @id @default(uuid())
  userId            String?      @unique // null until approved
  code              String       @unique
  firstName         String
  lastName          String
  storeName         String?
  phone             String       @unique // immutable by the client
  email             String?
  wilayaId          String
  communeId         String
  address           String?
  status            ClientStatus @default(PENDING)
  approvedAt        DateTime?
  approvedByStaffId String?
  rejectionReason   String?
  posClientId       String?      @unique // auto-created at approval
  isEnabled         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user       User?      @relation(fields: [userId], references: [id])
  wilaya     Wilaya     @relation(fields: [wilayaId], references: [id])
  commune    Commune    @relation(fields: [communeId], references: [id])
  approvedBy Staff?     @relation("ClientApprovedBy", fields: [approvedByStaffId], references: [id])
  posClient  PosClient? @relation(fields: [posClientId], references: [id])

  carts        ClientCart[]
  activityLogs ClientActivityLog[]
  orders       Order[]
}

model PosClient {
  id         String  @id @default(uuid())
  code       String  @unique
  name       String
  phone      String?
  categoryId String?
  credit     Decimal @default(0) @db.Decimal(12, 2) // owed to the store
  totalPaid  Decimal @default(0) @db.Decimal(12, 2)
  totalSold  Decimal @default(0) @db.Decimal(12, 2) // lifetime purchases (confirmed sales + orders)
  isEnabled  Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ClientCategory? @relation(fields: [categoryId], references: [id])

  linkedClient Client?
  sales        Sale[]
  repairs      Repair[]
  invoices     Invoice[]
  payments     ClientPayment[]
}

model ClientCart {
  clientId  String
  productId String
  addedAt   DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([clientId, productId])
}

model ClientActivityLog {
  id              String             @id @default(uuid())
  clientId        String
  type            ClientActivityType
  query           String?
  productId       String?
  durationSeconds Int?
  createdAt       DateTime           @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([clientId, createdAt])
}

model StaffSearchLog {
  id               String   @id @default(uuid())
  userId           String
  query            String
  matchedProductId String?
  createdAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  matchedProduct Product? @relation(fields: [matchedProductId], references: [id])

  @@index([userId, createdAt])
}

// ─────────────────────────── Catalog ───────────────────────────

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   DeviceModel[]
  repairs  Repair[]
  products Product[]
}

model DeviceModel {
  id        String   @id @default(uuid())
  brandId   String
  name      String
  slug      String   
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand               @relation(fields: [brandId], references: [id])
  families DeviceModelFamily[]
  products Product[]
  repairs  Repair[]

  @@unique([brandId, name])
}

model Family {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  iconUrl     String?
  parentId    String?
  isUniversal Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Family?  @relation("FamilyTree", fields: [parentId], references: [id])
  children Family[] @relation("FamilyTree")

  models   DeviceModelFamily[]
  products Product[]
}

model DeviceModelFamily {
  deviceModelId String
  familyId      String

  deviceModel DeviceModel @relation(fields: [deviceModelId], references: [id])
  family      Family      @relation(fields: [familyId], references: [id])

  @@id([deviceModelId, familyId])
}

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  barcode          String?  @unique
  name             String
  description      String?
  familyId         String
  brandId          String // independent of deviceModelId: a universal part still has a brand
  deviceModelId    String? // null = not pinned to a specific model within the brand
  guestPrice       Decimal? @db.Decimal(12, 2) // null => hidden from guests
  defaultSalePrice Decimal? @db.Decimal(12, 2) // null until first stock; POS fallback price
  avgStockPrice    Decimal  @default(0) @db.Decimal(12, 2) // quantity-weighted moving average (D10):
  //   margins, adjustment defaults, stock valuation. Profit is still FIFO, never this figure.
  avgPrice         Decimal  @default(0) @db.Decimal(12, 2) // unweighted mean of purchase unit costs
  //   across SUPPLIER_INVOICE + INITIAL_STOCK receipts (D10). Supplier-invoice context only.
  quantityOnHand   Int      @default(0) // owned by inventory module
  quantityReserved Int      @default(0) // owned by inventory module
  reorderThreshold Int      @default(0)
  isPublished      Boolean  @default(true)
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  family      Family       @relation(fields: [familyId], references: [id])
  brand       Brand        @relation(fields: [brandId], references: [id])
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id])

  images               ProductImage[]
  prices               ProductPrice[]
  carts                ClientCart[]
  movements            StockMovement[]
  adjustmentLines      StockAdjustmentLine[]
  supplierInvoiceLines SupplierInvoiceLine[]
  saleLines            SaleLine[]
  orderLines           OrderLine[]
  repairParts          RepairPart[]
  activityLogs         ClientActivityLog[]
  searchLogs           StaffSearchLog[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id])
}

model ProductPrice {
  id               String  @id @default(uuid())
  productId        String
  clientCategoryId String
  price            Decimal @db.Decimal(12, 2)

  product  Product        @relation(fields: [productId], references: [id])
  category ClientCategory @relation(fields: [clientCategoryId], references: [id])

  @@unique([productId, clientCategoryId])
}

// ─────────────────────── Inventory (FIFO) ───────────────────────

model StockMovement {
  id                String            @id @default(uuid())
  productId         String
  direction         MovementDirection
  type              MovementType
  quantity          Int // signed
  unitCost          Decimal?          @db.Decimal(12, 2) // IN: the layer's landed cost
  remainingQuantity Int? // IN: live FIFO layer, drained by consumptions
  costOfGoods       Decimal?          @db.Decimal(12, 2) // OUT
  profit            Decimal?          @db.Decimal(12, 2) // OUT; null for ADJUSTMENT_OUT
  balanceAfter      Int
  referenceType     String // SALE | ORDER | SUPPLIER_INVOICE | REPAIR | RETURN | ADJUSTMENT | PRODUCT
  referenceId       String
  reason            String?
  staffId           String
  createdAt         DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  consumptionsAsOut StockMovementConsumption[] @relation("OutMovement")
  consumptionsAsIn  StockMovementConsumption[] @relation("InMovement")

  @@index([productId, createdAt])
  @@index([productId, direction, remainingQuantity]) // FIFO layer scan
  @@index([referenceType, referenceId])
}

model StockMovementConsumption {
  id               String  @id @default(uuid())
  outMovementId    String
  inMovementId     String
  quantityConsumed Int
  unitCost         Decimal @db.Decimal(12, 2)

  outMovement StockMovement @relation("OutMovement", fields: [outMovementId], references: [id])
  inMovement  StockMovement @relation("InMovement", fields: [inMovementId], references: [id])

  @@index([outMovementId])
  @@index([inMovementId])
}

model StockAdjustment {
  id         String           @id @default(uuid())
  reference  String           @unique
  reason     AdjustmentReason
  note       String?
  staffId    String
  adjustedAt DateTime         @default(now())

  staff Staff                 @relation(fields: [staffId], references: [id])
  lines StockAdjustmentLine[]
}

model StockAdjustmentLine {
  id               String   @id @default(uuid())
  adjustmentId     String
  productId        String
  countedQuantity  Int
  previousQuantity Int
  delta            Int // signed
  unitCost         Decimal? @db.Decimal(12, 2) // IN deltas only

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
}

// ──────────────────── Suppliers & Purchasing ────────────────────

model Supplier {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  contactName   String?
  phone         String?
  email         String?
  location      String?
  credit        Decimal @default(0) @db.Decimal(12, 2) // store owes; opening = initialCredit
  totalPaid     Decimal @default(0) @db.Decimal(12, 2)
  totalInvoiced Decimal @default(0) @db.Decimal(12, 2)
  isEnabled     Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices SupplierInvoice[]
  payments SupplierPayment[]
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  reference         String                @unique
  supplierReference String?
  supplierId        String
  status            SupplierInvoiceStatus @default(DRAFT)
  invoiceDate       DateTime              @db.Date
  dueDate           DateTime?             @db.Date
  shippingCost      Decimal               @default(0) @db.Decimal(12, 2)
  amountOnly        Decimal?              @db.Decimal(12, 2) // XOR with lines
  totalAmount       Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(12, 2)
  paidDate          DateTime? // effective date of the most recent payment on this invoice; null while unpaid
  previousCredit    Decimal?              @db.Decimal(12, 2) // snapshot at confirm
  newCredit         Decimal?              @db.Decimal(12, 2)
  note              String?
  staffId           String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplier Supplier              @relation(fields: [supplierId], references: [id])
  staff    Staff                 @relation(fields: [staffId], references: [id])
  lines    SupplierInvoiceLine[]
  payments SupplierPayment[]
}

model SupplierInvoiceLine {
  id                  String  @id @default(uuid())
  supplierInvoiceId   String
  productId           String
  productNameSnapshot String
  quantity            Int
  unitCost            Decimal @db.Decimal(12, 2)
  landedUnitCost      Decimal @db.Decimal(12, 2) // unitCost + apportioned shipping
  lineTotal           Decimal @db.Decimal(12, 2)
  serialNumbers       String? // free text

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
}

model SupplierPayment {
  id                String   @id @default(uuid())
  reference         String   @unique
  supplierId        String
  supplierInvoiceId String?
  amount            Decimal  @db.Decimal(12, 2)
  previousCredit    Decimal  @db.Decimal(12, 2)
  newCredit         Decimal  @db.Decimal(12, 2)
  paidAt            DateTime @default(now())
  staffId           String

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])
  staff           Staff            @relation(fields: [staffId], references: [id])
}

// ───────────────────────── Sales (POS) ─────────────────────────

model Sale {
  id             String     @id @default(uuid())
  reference      String     @unique
  posClientId    String?
  status         SaleStatus @default(DRAFT)
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(12, 2)
  previousCredit Decimal?   @db.Decimal(12, 2) // receipt figures
  newCredit      Decimal?   @db.Decimal(12, 2)
  totalCost      Decimal    @default(0) @db.Decimal(12, 2)
  totalProfit    Decimal    @default(0) @db.Decimal(12, 2)
  soldAt         DateTime? // set at confirmation
  staffId        String // staff scoping key
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  posClient PosClient? @relation(fields: [posClientId], references: [id])
  staff     Staff      @relation(fields: [staffId], references: [id])
  lines     SaleLine[]
  returns   Return[]

  @@index([staffId, status])
}

model SaleLine {
  id                  String  @id @default(uuid())
  saleId              String
  productId           String
  productNameSnapshot String
  quantity            Int
  resolvedPrice       Decimal @db.Decimal(12, 2) // what the rules produced
  unitPrice           Decimal @db.Decimal(12, 2) // what was charged
  costOfGoods         Decimal @default(0) @db.Decimal(12, 2)
  profit              Decimal @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)
  serialNumbers       String?

  sale        Sale         @relation(fields: [saleId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  returnLines ReturnLine[]
}

model Return {
  id           String     @id @default(uuid())
  reference    String     @unique
  saleId       String
  type         ReturnType
  reason       String?
  refundAmount Decimal    @db.Decimal(12, 2)
  returnedAt   DateTime   @default(now())
  staffId      String

  sale  Sale         @relation(fields: [saleId], references: [id])
  staff Staff        @relation(fields: [staffId], references: [id])
  lines ReturnLine[]
}

model ReturnLine {
  id           String  @id @default(uuid())
  returnId     String
  saleLineId   String
  quantity     Int
  restock      Boolean // true => RETURN_IN at consumed cost
  refundAmount Decimal @db.Decimal(12, 2)

  return   Return   @relation(fields: [returnId], references: [id])
  saleLine SaleLine @relation(fields: [saleLineId], references: [id])
}

// ─────────────────────── Online Orders ───────────────────────
// Single-product orders: the line is folded into the order row.

model Order {
  id                  String      @id @default(uuid())
  reference           String      @unique
  clientId            String? // null for guests — no auto client row
  status              OrderStatus @default(PENDING)
  orderType           OrderType
  contactName         String
  contactPhone        String
  wilayaId            String? // null when pickup
  communeId           String?
  address             String?
  deliveryCompany     String?
  trackingNumber      String?
  productId           String
  productNameSnapshot String
  quantity            Int
  resolvedPrice       Decimal     @db.Decimal(12, 2) // frozen at placement
  unitPrice           Decimal     @db.Decimal(12, 2) // staff may adjust at confirmation
  serialNumbers       String? // entered at confirmation
  subtotal            Decimal     @db.Decimal(12, 2)
  deliveryFee         Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal     @db.Decimal(12, 2)
  paidAmount          Decimal     @default(0) @db.Decimal(12, 2)
  costOfGoods         Decimal?    @db.Decimal(12, 2) // set at confirmation (FIFO)
  profit              Decimal?    @db.Decimal(12, 2)
  placedAt            DateTime    @default(now())
  confirmedAt         DateTime?
  deliveredAt         DateTime? // at COMPLETED
  cancelledAt         DateTime?
  confirmedByStaffId  String?
  cancellationReason  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  client      Client?  @relation(fields: [clientId], references: [id])
  wilaya      Wilaya?  @relation(fields: [wilayaId], references: [id])
  commune     Commune? @relation(fields: [communeId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  confirmedBy Staff?   @relation("OrderConfirmedBy", fields: [confirmedByStaffId], references: [id])

  @@index([status, placedAt])
  @@index([clientId])
}

// ─────────────────────────── Repairs ───────────────────────────

model Repair {
  id                String       @id @default(uuid())
  reference         String       @unique
  posClientId       String?
  customerName      String
  customerPhone     String
  brandId           String?
  deviceModelId     String?
  deviceLabel       String?
  deviceImei        String?
  reportedIssues    String[] // charging | display | battery | camera | speaker | microphone | water-damage | software | other
  reportedIssueOther String?
  diagnosis         String?
  status            RepairStatus @default(INTAKE)
  technicianId      String? // required for PROCESSING
  labourPrice       Decimal      @default(0) @db.Decimal(12, 2)
  partsTotal        Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal      @default(0) @db.Decimal(12, 2)
  totalCost         Decimal?     @db.Decimal(12, 2)
  totalProfit       Decimal?     @db.Decimal(12, 2)
  intakeAt          DateTime     @default(now())
  completedAt       DateTime?
  pickedUpAt        DateTime?
  invoiceId         String?      @unique // invoice issued at PICKED_UP (D9); also the pickup idempotency latch
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  posClient   PosClient?   @relation(fields: [posClientId], references: [id])
  brand       Brand?       @relation(fields: [brandId], references: [id])
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id])
  technician  Technician?  @relation(fields: [technicianId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])

  parts   RepairPart[]
  history RepairStatusHistory[]

  @@index([status])
}

model RepairPart {
  id                  String   @id @default(uuid())
  repairId            String
  productId           String
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  costOfGoods         Decimal? @db.Decimal(12, 2)
  profit              Decimal? @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  serialNumbers       String?

  repair  Repair  @relation(fields: [repairId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model RepairStatusHistory {
  id         String       @id @default(uuid())
  repairId   String
  fromStatus RepairStatus
  toStatus   RepairStatus
  note       String?
  staffId    String
  changedAt  DateTime     @default(now())

  repair Repair @relation(fields: [repairId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])
}

// ───────────────────── Invoices & Payments ─────────────────────

model Invoice {
  id                    String        @id @default(uuid())
  number                String        @unique // FAC-YYYY-NNNN, never reused
  posClientId           String?
  sourceType            InvoiceSource // SALE | ORDER | REPAIR (D9)
  sourceId              String
  status                InvoiceStatus @default(ISSUED)
  clientNameSnapshot    String
  clientAddressSnapshot String?
  totalAmount           Decimal       @db.Decimal(12, 2)
  paidAmount            Decimal       @default(0) @db.Decimal(12, 2)
  previousCredit        Decimal?      @db.Decimal(12, 2)
  newCredit             Decimal?      @db.Decimal(12, 2)
  totalCost             Decimal       @default(0) @db.Decimal(12, 2)
  totalProfit           Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt              DateTime      @default(now())
  dueDate               DateTime?     @db.Date
  staffId               String // staff scoping key
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  posClient PosClient? @relation(fields: [posClientId], references: [id])
  staff     Staff      @relation(fields: [staffId], references: [id])

  lines    InvoiceLine[]
  payments ClientPayment[]
  repair   Repair?

  @@unique([sourceType, sourceId]) // idempotent issuance
  @@index([staffId])
}

model InvoiceLine {
  id            String  @id @default(uuid())
  invoiceId     String
  label         String
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  costSnapshot  Decimal @default(0) @db.Decimal(12, 2)
  profit        Decimal @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
  serialNumbers String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model ClientPayment {
  id             String   @id @default(uuid())
  reference      String   @unique
  posClientId    String
  invoiceId      String? // null = on account
  amount         Decimal  @db.Decimal(12, 2)
  previousCredit Decimal  @db.Decimal(12, 2)
  newCredit      Decimal  @db.Decimal(12, 2)
  paidAt         DateTime @default(now())
  staffId        String

  posClient PosClient @relation(fields: [posClientId], references: [id])
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])
}

// ─────────────────────────── System ───────────────────────────

model Setting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  actionType  String // open string — no enum, new actions need no schema change
  entityType  String
  entityId    String
  description String // one narrated string incl. before/after values
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([actionType, createdAt])
  @@index([userId])
}
