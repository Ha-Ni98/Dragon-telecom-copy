VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_ENABLED=false
VITE_WS_URL=http://localhost:3000

# S27.1 — deliberately EMPTY, and must stay empty.
# tests/fixtures/wrappers/setup.ts runs MSW with `onUnhandledRequest: "error"`, and the repairs
# page test renders <StaffRepairs />, which owns RepairTicketDetail, which mounts
# usePrintBridgeStatus(). An empty value makes getBridgeBaseUrl() return null, which disables the
# probe query, so no unmocked request can ever reach MSW.
VITE_PRINT_BRIDGE_URL=
