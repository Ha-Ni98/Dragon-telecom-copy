# Matches Apps/api's PORT=3000 and API_PREFIX=/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Realtime is opt-in. Leave false unless the app needs realtime (must match the api's
# WS_ENABLED). When true, connect to the server origin below (no /api/v1 prefix) — Socket.IO
# attaches at WS_PATH (default /socket.io), not under the REST prefix.
VITE_WS_ENABLED=false
VITE_WS_URL=http://localhost:3000
