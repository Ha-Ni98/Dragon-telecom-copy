# Matches Apps/api's PORT=3000 and API_PREFIX=/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Realtime is opt-in. Leave false unless the app needs realtime (must match the api's
# WS_ENABLED). When true, connect to the server origin below (no /api/v1 prefix) — Socket.IO
# attaches at WS_PATH (default /socket.io), not under the REST prefix.
VITE_WS_ENABLED=false
VITE_WS_URL=http://localhost:3000

# S27.1 — local print helper for thermal printing (ZPL labels / ESC-POS receipts).
# Empty or unset = feature OFF; every print uses the browser print dialog (today's behaviour).
#
# MUST be a loopback address (http://localhost:PORT or http://127.0.0.1:PORT) OR an https:// URL.
# The app is served over HTTPS in production, and loopback origins are the only plain-http ones a
# browser treats as "potentially trustworthy" — a LAN address such as http://192.168.1.50:9110
# WILL be blocked as mixed content. See Docs/print-bridge-protocol.md.
#
# Per-workstation override (no UI in 27.1): localStorage key `dt_print_bridge_url`.
VITE_PRINT_BRIDGE_URL=

# S38 — public origin of the web app, no trailing slash. Only index.html's static og:image uses it
# (link-preview scrapers need an absolute URL and never run JS). Example: https://dragontelecom.dz
# Left unset, Vite leaves the literal "%VITE_SITE_URL%" in that one tag — only share previews
# are affected.
VITE_SITE_URL=http://localhost:5173
